{
    "manifest_version": 3,
    "name": "AutOTP",
    "version": "1.0",
    "description": "Manage and autofill TOTP codes across any website",

    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },

    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "extension/background.ts",
        "scripts": ["extension/background.ts"]
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["extension/content.ts"]
        }
    ],

    "action": {
        "default_popup": "extension/popup/popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    }
}

